# Deploys to [ox]/ox_target, replacing the upstream release copy ghst_sv tracks.
#
# This file exists only on the ghst_ui branch. main stays a clean mirror of
# overextended/ox_target, and Tools/sync.sh looks for .sync in the *working tree* — so
# ghst_ui has to be the checked-out branch when you sync, exactly as with ox_lib.
category=[ox]

# Match what an upstream release ships: no NUI source, no lockfile-only tooling. web/build
# is produced by the build step and is what ui_page points at.
exclude=web/src
exclude=web/node_modules
